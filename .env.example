# Copy this file to .env and fill in real values. .env is gitignored — this
# .example file is the only one that should ever be committed.
#
# Get these from your Supabase project: Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Get this from https://aistudio.google.com/apikey. Used for LOCAL dev only —
# gen-config.mjs never writes this into a config.js meant for public deploy
# (see render-build.sh). For the real public site, set it as a Supabase Edge
# Function secret instead: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=
# gemini-3.5-flash-lite is the deliberate choice here, not a downgrade: on this
# app's real prompts it answers in ~1s (vs 20-40s for the full flash models),
# matches them on quality, resists prompt injection, and its free-tier daily
# allowance is far more generous. Measured, not assumed — see README.
GEMINI_MODEL=gemini-3.5-flash-lite

# true = run entirely on the built-in mock dataset, no network needed.
# false = use the real Supabase + Gemini values above.
FORCE_DEMO=true

# true = every Gemini feature returns its pre-written offline fallback answer
# instead of calling the real API — zero quota cost, safe for unlimited demo
# rehearsal. Independent of FORCE_DEMO, so you can rehearse against the real
# backend (real login, real classes) while keeping AI calls fake. Flip to
# false only for the actual live run.
FORCE_DEMO_AI=false

# Client-side safety net: after this many real Gemini calls in a day, every
# feature quietly serves its offline fallback instead. It is not the provider's
# real limit — it exists so a runaway loop can't silently drain the day's quota.
# Cached, repeated and de-duplicated answers don't count against it.
AI_DAILY_BUDGET=200

# OPTIONAL backup LLM. If Gemini returns 429 (daily quota gone) or has an
# outage, the app silently retries the same request against this provider
# instead of showing a pre-written answer — so one provider's daily cap stops
# being a single point of failure.
#
# Any OpenAI-compatible /chat/completions endpoint works. Free options:
#   Groq        https://api.groq.com/openai/v1/chat/completions
#               model: llama-3.3-70b-versatile        key: console.groq.com
#   OpenRouter  https://openrouter.ai/api/v1/chat/completions
#               model: meta-llama/llama-3.3-70b-instruct:free
#               key: openrouter.ai/keys
#   Cerebras    https://api.cerebras.ai/v1/chat/completions
#               model: llama-3.3-70b                  key: cloud.cerebras.ai
#
# Leave empty to disable. Note: the backup is skipped for the notebook scan —
# these text models can't see images, and a blind guess is worse than none.
AI_FALLBACK_URL=
AI_FALLBACK_KEY=
AI_FALLBACK_MODEL=
