# Secrets live in .env (never committed) and get compiled into config.js by
# `node scripts/gen-config.mjs` — neither of those should ever reach git.
# Commit .env.example instead so the required shape is documented.
.env
config.js
.DS_Store
*.log

# Supabase CLI scratch state (project ref, cached version numbers). Written by
# `supabase link`, machine-local, and meaningless to anyone else cloning this.
supabase/.temp/
